{
  "name": "exam-system-backend",
  "version": "1.0.0",
  "description": "Backend + database for the Choice/Matching/Written exam system",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "load-test": "node scripts/load-benchmark.js 1000 1 100",
    "load-test:postgres": "node scripts/load-benchmark.js 1000 1 200",
    "migrate:postgres": "node scripts/migrate-postgres.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "font-th-sarabun-new": "^1.0.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
